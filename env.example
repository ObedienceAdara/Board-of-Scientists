# ══════════════════════════════════════════════════════════════
# LLM PROVIDER
# ══════════════════════════════════════════════════════════════
LLM_PROVIDER=groq
# Options: groq | openrouter | openai

GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional per-agent model overrides. IDs must belong to the selected provider.
# CRO_MODEL=
# ANALYST_MODEL=
# THEORIST_MODEL=
# ARCHITECT_MODEL=
# ENGINEER_MODEL=
# REVIEWER_MODEL=
# EXPERIMENT_MODEL=
# WRITER_MODEL=

# ══════════════════════════════════════════════════════════════
# ANALYST / ENGINEER TUNING
# ══════════════════════════════════════════════════════════════
ANALYST_MAX_PAGES=300
ANALYST_REDUCE_FANOUT=6
ENGINEER_MAX_BATCH_SIZE=4

# ══════════════════════════════════════════════════════════════
# WEB SEARCH
# ══════════════════════════════════════════════════════════════
TAVILY_API_KEY=your_tavily_api_key_here

# ══════════════════════════════════════════════════════════════
# LANGSMITH (optional tracing)
# ══════════════════════════════════════════════════════════════
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=AIResearchTeam

# ══════════════════════════════════════════════════════════════
# HTTP CONTROL PLANE
# ══════════════════════════════════════════════════════════════
# development permits local unauthenticated requests; production fails closed
# unless API_AUTH_TOKEN is configured.
APP_ENV=development
API_AUTH_TOKEN=
UPLOADS_DIR=./uploads
OUTPUT_DIR=./outputs
HOST=127.0.0.1
PORT=8000

# Bound the in-process job manager. Use an external durable queue for multi-
# process production deployments.
RESEARCH_MAX_CONCURRENT_JOBS=1
RESEARCH_MAX_QUEUED_JOBS=8
RESEARCH_MAX_RETAINED_JOBS=256
