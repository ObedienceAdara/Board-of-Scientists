# ══════════════════════════════════════════════════════════════
# LLM PROVIDER
# ══════════════════════════════════════════════════════════════
# THE FIX: previously this file suggested overriding models with
# OpenRouter-style IDs (e.g. "anthropic/claude-3.5-sonnet") while the code
# was hardcoded to Groq's endpoint regardless — those model IDs would have
# been rejected by Groq's API. Set LLM_PROVIDER to pick ONE of the three
# below; each has its own API key variable and its own correct default
# model, and the *_MODEL overrides below must use IDs valid for whichever
# provider you pick (examples given per-provider).

LLM_PROVIDER=groq
# Options: groq | openrouter | openai

# ── If LLM_PROVIDER=groq (fast, free tier available) ────────────
GROQ_API_KEY=your_groq_api_key_here
# Model override examples (Groq-hosted open-weight models):
#   CRO_MODEL=llama-3.3-70b-versatile
#   ENGINEER_MODEL=llama-3.3-70b-versatile

# ── If LLM_PROVIDER=openrouter (access to many hosted models) ───
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Model override examples (OpenRouter namespaced model IDs):
#   CRO_MODEL=anthropic/claude-3.5-sonnet        <- synthesis & evaluation
#   ANALYST_MODEL=google/gemini-2.0-flash-001    <- long document reading
#   THEORIST_MODEL=deepseek/deepseek-r1          <- mathematical reasoning
#   ARCHITECT_MODEL=deepseek/deepseek-r1         <- systems design
#   ENGINEER_MODEL=anthropic/claude-3.5-sonnet   <- code generation
#   REVIEWER_MODEL=anthropic/claude-3.5-sonnet   <- code review
#   EXPERIMENT_MODEL=google/gemini-2.0-flash-001 <- fast, good for validation
#   WRITER_MODEL=anthropic/claude-3.5-haiku      <- documentation

# ── If LLM_PROVIDER=openai ───────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
# Model override examples:
#   CRO_MODEL=gpt-4o
#   ENGINEER_MODEL=gpt-4o

# ── Per-agent model overrides (optional) ─────────────────────────
# If unset, every agent uses the selected provider's default model.
# CRO_MODEL=
# ANALYST_MODEL=
# THEORIST_MODEL=
# ARCHITECT_MODEL=
# ENGINEER_MODEL=
# REVIEWER_MODEL=
# EXPERIMENT_MODEL=
# WRITER_MODEL=


# ══════════════════════════════════════════════════════════════
# WEB SEARCH
# ══════════════════════════════════════════════════════════════
TAVILY_API_KEY=your_tavily_api_key_here


# ══════════════════════════════════════════════════════════════
# LANGSMITH (optional tracing)
# ══════════════════════════════════════════════════════════════
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=AIResearchTeam


# ══════════════════════════════════════════════════════════════
# REST API (main.py serve)
# ══════════════════════════════════════════════════════════════
# If unset, the /implement-paper endpoint is UNAUTHENTICATED — fine for
# localhost-only use, but set this before exposing the server beyond your
# own machine. Requests must then include header: X-API-Key: <this value>
API_AUTH_TOKEN=

# Directory the server reads PDFs from. Requests reference files by name
# only (never a path) and are resolved inside this directory — this is what
# prevents a client from asking the server to open arbitrary files on disk.
UPLOADS_DIR=./uploads
